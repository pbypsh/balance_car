#============================================
# Keil MDK5 官方通用 .gitignore
#============================================
# 编译输出目录，**/代表任意子文件夹下面的Objects/Listings全部忽略
**/Objects/
**/Listings/

# 固件、可执行、中间目标文件
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.o
*.obj
*.d
*.crf
*.dep
*.i
*.iex
*.lnp
*.plg
*.build_log.htm
*.htm
*.bak
*.tmp
*.~*
*.scvd
*.dbgconf
*.cdb
*.tracespec

# 用户个人配置（窗口布局、断点，每个人电脑不一样，千万不要备份）
*.uvopt
*.uvoptx
*.uvguix.*
*.uvgui.*
*.uvmpw

# 调试器日志
JLinkLog.txt
*.jlink
*.ini
*.log

# VSCode本地缓存
.vscode/
*.code-workspace

# Windows系统垃圾
Thumbs.db
Desktop.ini
.DS_Store
